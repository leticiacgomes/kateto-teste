DATABASE_URL="postgresql://postgres:postgres@db:5432/dropbase?schema=public"

# Conexão direta (sem pooler), usada só pelo Prisma CLI (generate/migrate/studio,
# ver prisma.config.ts). Necessária em produção quando DATABASE_URL passa por um
# pooler (PgBouncer/Neon/Supabase etc) que não sustenta advisory lock de sessão.
# Em dev local (docker) pode ficar de fora — cai no fallback pra DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@db:5432/dropbase?schema=public"

# NextAuth (Credentials provider) — gerar com `openssl rand -base64 32`
AUTH_SECRET=""

# Usados só pelo prisma/seed.ts pra criar o usuário admin da área logada.
# Se omitidos, cai no default admin@dropbase.com / dropbase123 (dev only).
ADMIN_EMAIL="admin@dropbase.com"
ADMIN_PASSWORD="dropbase123"
