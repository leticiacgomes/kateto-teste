generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  SEM_CONTATO
  EM_CONTATO
  PERDIDO
  FINALIZADO
}

model Lead {
  id    String @id @default(cuid())
  name  String
  phone String

  status   LeadStatus @default(SEM_CONTATO)
  position Int        @default(0)

  skin   Skin   @relation(fields: [skinId], references: [id])
  skinId String

  representative   Representative @relation(fields: [representativeId], references: [id])
  representativeId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([representativeId])
  @@index([skinId])
}

model Representative {
  id    String @id @default(cuid())
  name  String
  order Int    @unique

  leads Lead[]
}

// Linha única (id fixo = 1). Ponteiro persistido do próximo Representative.order
// a receber um lead; avança dentro de uma transaction para evitar dois leads
// simultâneos "roubarem" o mesmo vendedor.
model RoundRobinState {
  id        Int      @id @default(1)
  nextIndex Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Dj {
  id       String  @id @default(cuid())
  name     String  @unique
  imageUrl String
  bio      String?

  skins Skin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skin {
  id          String  @id @default(cuid())
  name        String
  imageUrl    String
  price       Decimal @db.Decimal(10, 2)
  description String?

  dj   Dj     @relation(fields: [djId], references: [id])
  djId String

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([djId])
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String

  createdAt DateTime @default(now())
}
